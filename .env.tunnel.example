# Run on your own computer and share it through a Cloudflare quick tunnel (DEPLOYMENT.md, Option C).
# Copy to .env.prod and fill in the two secrets. Never commit .env.prod.

# ":80" = plain HTTP inside Docker; Cloudflare provides the HTTPS link. Don't change it.
DOMAIN=:80

# Letters and digits only. Any long random value, e.g. from: openssl rand -hex 24
POSTGRES_PASSWORD=

# Any long random value, e.g. from: openssl rand -hex 32
JWT_SECRET=

# Optional: Google OAuth Web client id. Add the tunnel URL to its Authorized JavaScript origins.
GOOGLE_CLIENT_ID=

MAIL_MODE=ethereal
ETHEREAL_USER=
ETHEREAL_PASS=
