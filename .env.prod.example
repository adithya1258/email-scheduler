# Used by docker-compose.prod.yml (single-server deployment).
# Copy to .env.prod and fill in. Never commit .env.prod.

# Domain pointing at this server (A record), without https://
DOMAIN=scheduler.example.com

# Letters and digits only (it goes inside a URL). Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Long random string. Generate with: openssl rand -hex 32
JWT_SECRET=

# Google OAuth Web client id (see DEPLOYMENT.md, step 1)
GOOGLE_CLIENT_ID=

# ethereal = real SMTP to Ethereal; log = no SMTP, just log messages
MAIL_MODE=ethereal
# Optional fixed Ethereal account (https://ethereal.email/create); empty = auto-create
ETHEREAL_USER=
ETHEREAL_PASS=

WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
