# --- Server ---
PORT=4000
# Comma separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=change-me-to-a-long-random-string

# --- Google OAuth (same client id as the frontend's NEXT_PUBLIC_GOOGLE_CLIENT_ID) ---
GOOGLE_CLIENT_ID=

# --- Infrastructure ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/email_scheduler
REDIS_URL=redis://localhost:6379

# --- Worker / throughput ---
# Run the BullMQ worker inside the API process (set false and run `npm run dev:worker` to scale separately)
RUN_WORKER=true
# How many jobs a single worker process handles in parallel
WORKER_CONCURRENCY=5
# Minimum gap between two sends across ALL workers (provider throttling), in ms
MIN_DELAY_BETWEEN_EMAILS_MS=2000
# Hard cap per sender per hour; a campaign's own hourly limit can only lower this
MAX_EMAILS_PER_HOUR_PER_SENDER=200

# --- SMTP (Ethereal) ---
# "ethereal" = real SMTP send to Ethereal (fake inbox, viewable preview URL)
# "log"      = don't open an SMTP connection, just log the message (offline dev / CI)
MAIL_MODE=ethereal
# Optional: fixed Ethereal credentials (https://ethereal.email/create).
# If empty, an account is created automatically on first boot and stored in the DB.
ETHEREAL_USER=
ETHEREAL_PASS=
